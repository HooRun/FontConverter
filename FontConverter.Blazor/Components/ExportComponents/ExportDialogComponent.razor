@using FontConverter.SharedLibrary.Models
@using static FontConverter.SharedLibrary.Helpers.LVGLFontEnums

<RadzenStack Orientation="Orientation.Vertical"
             AlignItems="AlignItems.Normal"
             JustifyContent="JustifyContent.Normal"
             Gap="15px">

    <RadzenDataGrid @bind-Data="@GridData"
                    Count="@_TotalGlyphCount"
                    TItem="LVGLGlyph"
                    GridLines="DataGridGridLines.Both"
                    Density="Density.Compact"
                    SelectionMode="DataGridSelectionMode.Multiple"
                    AllowColumnResize="true"
                    AllowVirtualization="@_GridAllowVirtualization"
                    AllowPaging="@_GridAllowPaging"
                    AllowSorting="true"
                    AllowGrouping="true"
                    AllowFiltering="true"
                    @bind-AllGroupsExpanded="@_GridAllGroupsExpanded"
                    PageSize="50"                    
                    HideGroupedColumn="false"
                    ShowGroupExpandColumn="true"
                    FilterMode="FilterMode.CheckBoxList"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    LogicalFilterOperator="LogicalFilterOperator.Or"
                    FilterCleared=@FilterCleared
                    ExpandMode="DataGridExpandMode.Single"
                    Style="height: 300px; font-size:10px;"
                    @ref="_GlyphsDataGrid">
        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Vertical"
                         AlignItems="AlignItems.Normal"
                         JustifyContent="JustifyContent.Normal"
                         Gap="10px"
                         Style="width: 100%; padding: 5px;">
                <RadzenText Text="Gropu By:" TextStyle="TextStyle.Overline" />
                <RadzenRadioButtonList Value=@_GridGroupOption TValue="int" Change=@OnGridGroupOptionChange>
                    <Items>
                        <RadzenRadioButtonListItem Text="None" Value="1" />
                        <RadzenRadioButtonListItem Text="Glyph Content" Value="2" />
                        <RadzenRadioButtonListItem Text="Unicode Ranges" Value="3" />
                    </Items>
                </RadzenRadioButtonList>
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             Gap="10px"
                             Visible="@(_GridGroupOption==2 || _GridGroupOption==3)">
                    <RadzenButton Icon="expand_all"
                                  Text=""
                                  ButtonStyle="ButtonStyle.Base"
                                  Size="ButtonSize.ExtraSmall"
                                  Click="@((args) =>_GridAllGroupsExpanded=true)" />

                    <RadzenText Text="Expand All" TextStyle="TextStyle.Caption" />

                    <RadzenButton Icon="collapse_all"
                                  Text=""
                                  ButtonStyle="ButtonStyle.Base"
                                  Size="ButtonSize.ExtraSmall"
                                  Click="@((args) =>_GridAllGroupsExpanded=false)" />

                    <RadzenText Text="Collapse All" TextStyle="TextStyle.Caption" />
                </RadzenStack>
            </RadzenStack>
        </HeaderTemplate>
        <EmptyTemplate>
            <span style="color: lightgrey; font-size: 14px; text-align: center;">No records to display.</span>
        </EmptyTemplate>
        <GroupHeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="10px"
                         Style="height: 50px;">
                <RadzenCheckBox TabIndex="-1"
                                TriState="false"
                                TValue="bool?"
                                Value="@GetGroupCheckBoxValue((string)context.Data.Key)"
                                Change="@((args) => OnGroupCheckboxChanged((string)context.Data.Key, args))" />
                <RadzenText Text="@GetGroupLabel((string)context.Data.Key)" TextStyle="TextStyle.Subtitle2"/>
            </RadzenStack>
        </GroupHeaderTemplate>
        <Columns>
            <RadzenDataGridColumn Width="35px"
                                  TextAlign="TextAlign.Center"
                                  Sortable="false"
                                  Filterable="false"
                                  Groupable="false">
                <HeaderTemplate>
                    <RadzenCheckBox TabIndex="-1"
                                    TriState="false"
                                    TValue="bool?"
                                    Value="@GetSelectAllValue()"
                                    Change="@(async args => await OnSelectAllChangedAsync(args))" />
                </HeaderTemplate>
                <Template Context="data">
                    <RadzenCheckBox TabIndex="-1"
                                    TriState="false"
                                    TValue="bool"
                                    Value="@(_SelectedGlyphsList.Contains(data))"
                                    Change="@(async args => await OnRowCheckboxChangedAsync(data, args))" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="SVG"
                                  Title="Shape"
                                  Width="70px"
                                  TextAlign="TextAlign.Center"
                                  Sortable="false"
                                  AllowCheckBoxListVirtualization=true>
                <Template Context="data">
                    <RadzenStack Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center"
                                 JustifyContent="JustifyContent.Center"
                                 Style="width:50px; height:50px; overflow: hidden;">
                        <GlyphSVGComponent SVG="data.SVG" Height="40" MaxWidth="50" />
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Index"
                                  Title="ID"
                                  Width="80px"
                                  TextAlign="TextAlign.Left"
                                  AllowCheckBoxListVirtualization=true>
                <Template Context="data">
                    <span style="font-size: 12px; text-align: center; width: 100%;">@data.Index</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(GlyphItemModel.Name)"
                                  Title="Glyph Name"
                                  TextAlign="TextAlign.Left"
                                  AllowCheckBoxListVirtualization=true>
                <Template Context="data">
                    <span style="font-size: 12px;">@data.Name</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="Unicodes"
                                  Title="Unicodes"
                                  TextAlign="TextAlign.Left"
                                  FilterValue="@_SelecedUnicodesFirstFilter"
                                  FilterMode="FilterMode.CheckBoxList"
                                  FilterOperator="FilterOperator.In"
                                  FilterProperty="Unicodes"
                                  Type="typeof(IList<string>)"
                                  SortProperty="Unicodes.Count"
                                  AllowCheckBoxListVirtualization=true>
                <Template Context="data">
                    <span style="font-size: 12px;">@string.Join(", ", data.Unicodes.Where(s => !string.IsNullOrWhiteSpace(s)))</span>
                </Template>
                <FilterValueTemplate>
                    <RadzenListBox @bind-Value=@_SelecedUnicodesFirstFilter
                                   Style="width:100%; height: 300px;"
                                   Change=@OnSelecedUnicodesFirstFilterChange
                                   Data="@(_AllUnicodesFilter)"
                                   AllowClear="true"
                                   Multiple="true"
                                   TValue="IList<string>"
                                   AllowFiltering="true"
                                   Count="@(_AllUnicodesFilter.Count)"
                                   AllowVirtualization=true />
                </FilterValueTemplate>

            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    <RadzenTabs RenderMode="TabRenderMode.Client"
                TabPosition="TabPosition.Top"
                @bind-SelectedIndex=@_SelectedTabIndex>
        <Tabs>
            <RadzenTabsItem Text="C">

                <RadzenStack Orientation="Orientation.Vertical"
                             AlignItems="AlignItems.Normal"
                             JustifyContent="JustifyContent.Normal"
                             Gap="15px">

                    <ExportTypeComponent FileType=LVGL_FILE_TYPE.LVGL_FILE_TYPE_C
                                        Glyphs=@_SelectedGlyphsList
                                        Blocks="@PredefinedData.Blocks"/>

                </RadzenStack>

            </RadzenTabsItem>

            <RadzenTabsItem Text="Symbol">

                <RadzenStack Orientation="Orientation.Vertical"
                             AlignItems="AlignItems.Normal"
                             JustifyContent="JustifyContent.Normal"
                             Gap="15px">

                    <ExportTypeComponent FileType=LVGL_FILE_TYPE.LVGL_FILE_TYPE_SYMBOL
                                        Glyphs=@_SelectedGlyphsList
                                        Blocks="@PredefinedData.Blocks" />

                </RadzenStack>

            </RadzenTabsItem>

            <RadzenTabsItem Text="Binary">

                <ExportTypeComponent FileType=LVGL_FILE_TYPE.LVGL_FILE_TYPE_BINARY
                                    Glyphs=@_SelectedGlyphsList 
                                    Blocks="@PredefinedData.Blocks" />

            </RadzenTabsItem>

            <RadzenTabsItem Text="SVG">

                <RadzenStack Orientation="Orientation.Vertical"
                             AlignItems="AlignItems.Normal"
                             JustifyContent="JustifyContent.Normal"
                             Gap="15px">
                    
                    <ExportTypeComponent FileType=LVGL_FILE_TYPE.LVGL_FILE_TYPE_SVG_H
                                        Glyphs=@_SelectedGlyphsList 
                                        Blocks="@PredefinedData.Blocks" />

                </RadzenStack>

            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</RadzenStack>

<style>

    .rz-custom-header {
        width: 100%;
    }

    .rz-group-header-drop {
        display: none !important;
    }

    .rz-group-header-items {
        display: none !important;
    }

    .rz-column-drag {
        visibility: hidden !important;
    }

    .rz-radiobutton-label {
        margin-inline: 0.5rem !important;
    }

    .rz-row-toggler {
        cursor: pointer;
    }

</style>