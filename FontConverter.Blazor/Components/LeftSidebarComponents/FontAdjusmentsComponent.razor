
<RadzenAccordion Multiple="false">
    <Items>
        <RadzenAccordionItem Text="@SharedResources.Text_Accordion_Font_Adjusment"
                             Icon="@SharedResources.Icon_Accordion_Font_Adjusment">
            <RadzenStack Orientation="Orientation.Vertical"
                         AlignItems="AlignItems.Start"
                         JustifyContent="JustifyContent.Normal"
                         Gap="15">

                <RadzenText Style="color:#605e5c; font-size: 0.75rem;">
                    Anti-Alias
                </RadzenText>
                <RadzenSwitch @bind-Value=@MainViewModel.FontAdjusmentsViewModel.AntiAlias
                              Style="margin-left: 20px;" />

                <RadzenText Style="color:#605e5c; font-size: 0.75rem;">
                    Dither
                </RadzenText>
                <RadzenSwitch @bind-Value=@MainViewModel.FontAdjusmentsViewModel.Dither
                              Style="margin-left: 20px;" />

                <RadzenFormField AllowFloatingLabel="@floatFieldLabel"
                                 Text="Style"
                                 Variant="@variant"
                Style="width: 100%;">
                    <ChildContent>
                        <RadzenDropDown @bind-Value=@MainViewModel.FontAdjusmentsViewModel.Style
                                        Data=@PredefinedData.GlyphStyleList
                                        TextProperty="Value"
                                        ValueProperty="Key" />
                    </ChildContent>
                </RadzenFormField>

                <RadzenText Style="color:#605e5c; font-size: 0.75rem;">
                    Stroke Width
                </RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Style="width: 100%; padding-left: 20px;">
                    <RadzenSlider Min="0"
                                  Max="20"
                                  TValue="int"
                                  @bind-Value=@MainViewModel.FontAdjusmentsViewModel.StrokeWidth
                                  Style="width:60% !important;" />
                    <RadzenBadge BadgeStyle="BadgeStyle.Base"
                                 Text="@(string.Format("{0:N0}",MainViewModel.FontAdjusmentsViewModel.StrokeWidth))"
                                 Style="width: 30% !important;" />
                </RadzenStack>

                <RadzenText Style="color:#605e5c; font-size: 0.75rem;">
                    Gamma
                </RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Style="width: 100%; padding-left: 20px;">
                    <GradienSlider @bind-Value=@MainViewModel.FontAdjusmentsViewModel.Gamma
                                   TValue="int"
                                   Min="0"
                                   Max="100"
                                   TValue="int"
                                   IsReverse=true
                                   Change="@GammaChanged"
                                   Style="width:60% !important; height: 12px; background: #ffffff; background: linear-gradient(90deg, black 0%, white 100%); border: 2px solid #DDD !important;" />
                    <RadzenBadge BadgeStyle="BadgeStyle.Base"
                                 Text="@(string.Format("{0:0.0}",_GammaValue))"
                                 Style="width: 30% !important;" />
                </RadzenStack>

                <RadzenText Style="color:#605e5c; font-size: 0.75rem;">
                    Threshold
                </RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Style="width: 100%; padding-left: 20px;">
                    <GradienSlider @bind-Value=@MainViewModel.FontAdjusmentsViewModel.Threshold
                                   TValue="int"
                                   Min="0"
                                   Max="255"
                                   TValue="int"
                                   Style="width:60% !important; height: 12px; background: #ffffff; background: linear-gradient(90deg, white 0%, black 100%); border: 2px solid #DDD !important;" />
                    <RadzenBadge BadgeStyle="BadgeStyle.Base"
                                 Text="@(string.Format("{0:N0}",MainViewModel.FontAdjusmentsViewModel.Threshold))"
                                 Style="width: 30% !important;" />
                </RadzenStack>

            </RadzenStack>
        </RadzenAccordionItem>
    </Items>
</RadzenAccordion>
