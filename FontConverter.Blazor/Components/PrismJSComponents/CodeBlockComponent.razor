<RadzenCard Variant="Variant.Outlined"
            Style="background-color: #F9F9F9; padding: 10px;">

    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween">

        <RadzenStack Orientation="Orientation.Vertical"
                     Gap="3px"
                     Style="min-width: 0; flex-shrink: 1;">
            <RadzenText Text="@_FileName" TextStyle="TextStyle.Subtitle2" Style="white-space: normal; word-break: break-all;" />
            <RadzenText Text="@_SizeText" TextStyle="TextStyle.Overline" Style="white-space: normal; word-break: break-all;" />
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Gap="10px"
                     Style="flex-shrink: 0;">

            <RadzenButton Text=""
                          Icon="download"
                          ButtonStyle="ButtonStyle.Base"
                          Size="ButtonSize.Small"
                          IsBusy="@_IsDownloadBusy"
                          Disabled="@(string.IsNullOrEmpty(_Code))"
                          Click="@OnDownloadFile" />

            <RadzenButton Text=""
                          Icon="content_copy"
                          ButtonStyle="ButtonStyle.Base"
                          Size="ButtonSize.Small"
                          IsBusy="@_IsCopyBusy"
                          Disabled="@(string.IsNullOrEmpty(_Code))"
                          Click="@CopyToClipboard" />

            <RadzenButton Text="@($"Generate ({_MergedGlyphs.Count})")"
                          Icon="order_play"
                          ButtonStyle="ButtonStyle.Secondary"
                          Size="ButtonSize.Small"
                          Shade="Shade.Lighter"
                          IsBusy=@_IsGenerateBusy 
                          BusyText="Generating"
                          Disabled="@(Glyphs == null || Glyphs?.Count == 0)"
                          Click="@OnGenerateClick" />

        </RadzenStack>

    </RadzenStack>

</RadzenCard>

