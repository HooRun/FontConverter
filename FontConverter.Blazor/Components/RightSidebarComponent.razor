<RadzenSidebar @bind-Expanded="@MainViewModel.RightSidebarExpanded"
               Responsive="false"
               class="right-sidebar">
    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 Style="position: sticky; top: 0; z-index: 4; width: 100% !important; background-color: whitesmoke;"
                 class="rz-p-2">
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Gap="5px">
            @if (MainViewModel.LastSelectedGlyph != null)
            {
                <RadzenStack Orientation="Orientation.Vertical"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.Center"
                             Style="width:60px; height:60px; padding: 5px; background-color: rgba(255,255,255,0.7); overflow: hidden;">
                    <GlyphSVGComponent SVG="MainViewModel.LastSelectedGlyph.SVG" Height="50" MaxWidth="50" />
                </RadzenStack>

                <RadzenStack Orientation="Orientation.Vertical"
                             AlignItems="AlignItems.Start"
                             Gap="5px">
                    <RadzenText Style="vertical-align:middle !important; "
                                Text="Glyph Properties"
                                Visible="true" />
                    <RadzenText Text="@($"Glyph ID: {MainViewModel.LastSelectedGlyph.Index}")" Style="font-size: 12px;"/>
                </RadzenStack>
            }
        </RadzenStack>
        <RadzenButton Style="margin-left: auto; font-weight: 700;"
                      Icon="close" Variant="Variant.Flat"
                      ButtonStyle="ButtonStyle.Base"
                      Shade="Shade.Lighter"
                      Size="ButtonSize.Large"
                      class="rz-border-radius-10 rz-shadow-10"
                      Click="@(() => MainViewModel.RightSidebarExpanded = false)" />
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Vertical"
                 AlignItems="AlignItems.Stretch"
                 Wrap="FlexWrap.NoWrap"
                 Gap="15px"
                 style="padding: 15px;">
        <GlyphParametersComponent />
        <GlyphUnicodesComponent />
        <GlyphKerningsComponent />
        <GlyphAdjusmentsComponent />
    </RadzenStack>
</RadzenSidebar>