<RadzenAccordion Multiple="false">
    <Items>
        <RadzenAccordionItem Text="Glyph Parameters" Icon="list_alt">
            <RadzenStack Orientation="Orientation.Vertical" Gap="15">

                <RadzenFormField AllowFloatingLabel="@floatFieldLabel"
                                 Variant="@variant"
                                 Text="Glyph Name">
                    <ChildContent>
                        <RadzenTextBox Value="@MainViewModel.LastSelectedGlyph?.Name"
                                       Change="@OnGlyphNameChanged" />
                    </ChildContent>
                </RadzenFormField>

                <RadzenFormField AllowFloatingLabel="@floatFieldLabel"
                                 Variant="@variant"
                                 Text="Glyph Description">
                    <ChildContent>
                        <RadzenTextBox Value="@MainViewModel.LastSelectedGlyph?.Description"
                                       Change="@OnGlyphDescriptionChanged" />
                    </ChildContent>
                </RadzenFormField>

                <RadzenFormField AllowFloatingLabel="@floatFieldLabel"
                                 Variant="@variant"
                                 Text="Width">
                    <ChildContent>
                        <RadzenNumeric Value="@MainViewModel.LastSelectedGlyph?.Descriptor.Width"
                                       Change="@OnGlyphWidthChanged" 
                                       TValue="int?"
                                       Min="@int.MinValue"
                                       Max="@int.MaxValue"/>
                    </ChildContent>
                </RadzenFormField>

                <RadzenFormField AllowFloatingLabel="@floatFieldLabel"
                                 Variant="@variant"
                                 Text="Height">
                    <ChildContent>
                        <RadzenNumeric Value="@MainViewModel.LastSelectedGlyph?.Descriptor.Height"
                                       Change="@OnGlyphHeightChanged"
                                       TValue="int?"
                                       Min="@int.MinValue"
                                       Max="@int.MaxValue" />
                    </ChildContent>
                </RadzenFormField>

                <RadzenFormField AllowFloatingLabel="@floatFieldLabel"
                                 Variant="@variant"
                                 Text="Offset X">
                    <ChildContent>
                        <RadzenNumeric Value="@MainViewModel.LastSelectedGlyph?.Descriptor.OffsetX"
                                       Change="@OnGlyphOffsetXChanged"
                                       TValue="int?"
                                       Min="@int.MinValue"
                                       Max="@int.MaxValue" />
                    </ChildContent>
                </RadzenFormField>

                <RadzenFormField AllowFloatingLabel="@floatFieldLabel"
                                 Variant="@variant"
                                 Text="Offset Y">
                    <ChildContent>
                        <RadzenNumeric Value="@MainViewModel.LastSelectedGlyph?.Descriptor.OffsetY"
                                       Change="@OnGlyphOffsetYChanged"
                                       TValue="int?"
                                       Min="@int.MinValue"
                                       Max="@int.MaxValue" />
                    </ChildContent>
                </RadzenFormField>

                <RadzenFormField AllowFloatingLabel="@floatFieldLabel"
                                 Variant="@variant"
                                 Text="Advance Width">
                    <ChildContent>
                        <RadzenNumeric Value="@MainViewModel.LastSelectedGlyph?.Descriptor.AdvanceWidth"
                                       Change="@OnGlyphAdvanceWidthChanged"
                                       TValue="int?"
                                       Min="@int.MinValue"
                                       Max="@int.MaxValue" />
                    </ChildContent>
                </RadzenFormField>

            </RadzenStack>
        </RadzenAccordionItem>
    </Items>
</RadzenAccordion>
