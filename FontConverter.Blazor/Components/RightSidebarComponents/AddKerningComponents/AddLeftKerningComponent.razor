<RadzenStack Orientation="Orientation.Vertical"
Gap="10px">

    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal"
        AlignItems="AlignItems.Center"
        JustifyContent="JustifyContent.SpaceBetween">
            <RadzenStack Orientation="Orientation.Vertical"
            AlignItems="AlignItems.Normal"
            JustifyContent="JustifyContent.SpaceBetween"
            Style="height: 100%;">
                <RadzenText Text="@($"Glyph On The {(IsLeftKerning ? "Left" : "Right")}")" TextStyle="TextStyle.DisplayH6" />
                <RadzenText Text="@($"Glyph ID: {MainViewModel.LastSelectedGlyph?.Index}")" TextStyle="TextStyle.Body1" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Vertical"
            AlignItems="AlignItems.Center"
            JustifyContent="JustifyContent.Center"
            Style="width:100px; height:70px; overflow: hidden;">
                <GlyphSVGComponent SVG="MainViewModel.LastSelectedGlyph?.SVG" Height="70" MaxWidth="100" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    <RadzenDataGrid Data="@MainViewModel.GlyphsList.Values"
    GridLines="DataGridGridLines.Both"
    SelectionMode="DataGridSelectionMode.Multiple"
    AllowColumnResize="true"
    AllowVirtualization="true"
    AllowSorting="true"
    AllowFiltering="true"
    FilterMode="FilterMode.CheckBoxList"
    Density="Density.Compact"
    Value=@_SelectedGlyphsList
    TItem="GlyphItemModel"
    ValueChanged="@OnGlyphsChanged"
    Style="height: 300px; font-size:10px;">
        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal"
            AlignItems="AlignItems.Center">
                <RadzenText Text="@($"Select {(IsLeftKerning ? "Right" : "Left")} Side Glyphs")" TextStyle="TextStyle.DisplayH6" />
            </RadzenStack>
        </HeaderTemplate>
        <EmptyTemplate>
            <p style="color: lightgrey; font-size: 24px; text-align: center; margin: 2rem;">No records to display.</p>
        </EmptyTemplate>
        <Columns>
            <RadzenDataGridColumn Property="@nameof(GlyphItemModel.SVG)"
            Title="Shape"
            Width="70px"
            TextAlign="TextAlign.Center"
            Sortable="false"
            Filterable="false"
            AllowCheckBoxListVirtualization=true>
                <Template Context="data">
                    <RadzenStack Orientation="Orientation.Horizontal"
                    AlignItems="AlignItems.Center"
                    JustifyContent="JustifyContent.Center"
                    Style="width:50px; height:50px; overflow: hidden;">
                        <GlyphSVGComponent SVG="data.SVG" Height="40" MaxWidth="50" />
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(GlyphItemModel.Index)"
            Title="ID"
            Width="80px"
            TextAlign="TextAlign.Center"
            AllowCheckBoxListVirtualization=true>
                <Template Context="data">
                    @if (IsLeftKerning)
                    {
                        @if (MainViewModel.LastSelectedGlyph != null && MainViewModel.LastSelectedGlyph.LeftKernings.Any(k => k.Right == data.Index))
                        {
                            <span style="font-size: 12px; color: gray;">@data.Index</span>
                        }
                        else
                        {
                            <span style="font-size: 12px;">@data.Index</span>
                        }
                        
                    }
                    else
                    {
                        @if (MainViewModel.LastSelectedGlyph != null && MainViewModel.LastSelectedGlyph.RightKernings.Any(k => k.Left == data.Index))
                        {
                            <span style="font-size: 12px; color: gray;">@data.Index</span>
                        }
                        else
                        {
                            <span style="font-size: 12px;">@data.Index</span>
                        }
                    }

                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(GlyphItemModel.Name)"
                                  Title="Block Name"
                                  TextAlign="TextAlign.Left"
                                  AllowCheckBoxListVirtualization=true>
                <Template Context="data">
                    @if (IsLeftKerning)
                    {
                        @if (MainViewModel.LastSelectedGlyph != null && MainViewModel.LastSelectedGlyph.LeftKernings.Any(k => k.Right == data.Index))
                        {
                            <span style="font-size: 12px; color: gray;">@data.Name</span>
                        }
                        else
                        {
                            <span style="font-size: 12px;">@data.Name</span>
                        }

                    }
                    else
                    {
                        @if (MainViewModel.LastSelectedGlyph != null && MainViewModel.LastSelectedGlyph.RightKernings.Any(k => k.Left == data.Index))
                        {
                            <span style="font-size: 12px; color: gray;">@data.Name</span>
                        }
                        else
                        {
                            <span style="font-size: 12px;">@data.Name</span>
                        }
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    <RadzenFormField AllowFloatingLabel="@floatFieldLabel"
                     Variant="@variant"
                     Text="Value">
        <ChildContent>
            <RadzenNumeric @bind-Value="@(_KerningValue)"
                           Min="@short.MinValue"
                           Max="@short.MaxValue" />
        </ChildContent>
    </RadzenFormField>

    <RadzenRow JustifyContent="JustifyContent.Center"
               AlignItems="AlignItems.Center"
               class="rz-text-align-center">
        <RadzenColumn>
            <RadzenButton Text="@($"Add ({_SelectedGlyphsList?.Count??0})")"
                          Click="@OnAddClick"
                          Disabled="@(_SelectedGlyphsList?.Count<=0 || _SelectedGlyphsList==null)"
                          ButtonStyle="ButtonStyle.Primary" />
        </RadzenColumn>
        <RadzenColumn>
            <RadzenButton Text="Close" Click="@((args) => _DialogService.Close(false))"
                          ButtonStyle="ButtonStyle.Base" />
        </RadzenColumn>
    </RadzenRow>

</RadzenStack>