@using FontConverter.SharedLibrary.Models

<RadzenAccordion Multiple="false">
    <Items>
        <RadzenAccordionItem Text="Glyph Unicodes" Icon="public">
            <RadzenStack Orientation="Orientation.Vertical"
                         Gap="15">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenButton Text="Add"
                                  Icon="add_circle"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.ExtraSmall"
                                  Shade="Shade.Lighter" />
                    <RadzenButton Text="Remove"
                                  Icon="do_not_disturb_on"
                                  ButtonStyle="ButtonStyle.Secondary"
                                  Size="ButtonSize.ExtraSmall"
                                  Shade="Shade.Lighter" />
                </RadzenStack>
                <RadzenListBox TValue="int?"
                               Value=@value
                               Data="@MainViewModel.LastSelectedGlyph?.CodePoints.Values"
                               TextProperty="@nameof(UnicodeCharacter.Name)"
                               ValueProperty="@nameof(UnicodeCharacter.CodePoint)"
                               Style="min-height:100px; width: 100%;">
                    <Template>
                        <RadzenStack Orientation="Orientation.Vertical"
                                     Gap="0px">
                            <RadzenText Text="@($"U+{(context as UnicodeCharacter)?.CodePoint:X4}")" />
                            <RadzenText Style="font-size:10px" Text="@((context as UnicodeCharacter)?.Name)" />
                        </RadzenStack>
                    </Template>
                </RadzenListBox>

            </RadzenStack>
        </RadzenAccordionItem>
    </Items>
</RadzenAccordion>