@using FontConverter.SharedLibrary.Models

<RadzenAccordion Multiple="false">
    <Items>
        <RadzenAccordionItem Text="Glyph Unicodes"
                             Icon="public">
            <RadzenStack Orientation="Orientation.Vertical"
                         Gap="15px">

                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenButton Text="Add"
                                  Icon="add_circle"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.ExtraSmall"
                                  Shade="Shade.Lighter"
                                  Click="@OnAddClick" />
                    <RadzenButton Text="Remove"
                                  Icon="do_not_disturb_on"
                                  ButtonStyle="ButtonStyle.Secondary"
                                  Size="ButtonSize.ExtraSmall"
                                  Shade="Shade.Lighter"
                                  Click="OnRemoveClick" />
                </RadzenStack>

                <RadzenListBox @bind-Value=@_SelectedChar
                               TValue="UnicodeCharacter"
                               AllowClear=true
                               Data="@MainViewModel.LastSelectedGlyph?.CodePoints.Values"
                               Style="min-height: 100px; max-height: 300px; width: 100%;">
                    <Template>
                        <RadzenStack Orientation="Orientation.Vertical"
                                     Gap="0px">
                            <RadzenText Text="@($"U+{(context as UnicodeCharacter)?.CodePoint:X4}")" />
                            <RadzenText Style="font-size:10px" Text="@((context as UnicodeCharacter)?.Name)" />
                        </RadzenStack>
                    </Template>
                </RadzenListBox>

            </RadzenStack>
        </RadzenAccordionItem>
    </Items>
</RadzenAccordion>