@using FontConverter.SharedLibrary.Models

<RadzenAccordion Multiple="false">
    <Items>
        <RadzenAccordionItem Text="Glyph Kernings"
                             Icon="format_letter_spacing_standard">
            <RadzenStack Orientation="Orientation.Vertical"
                         Gap="15">

                @* Glyph On The Left *@
                <RadzenStack Orientation="Orientation.Vertical" Gap="5px">
                    <RadzenText Text="Glyph On The Left:" TextStyle="TextStyle.Subtitle2" />
                    <RadzenListBox @bind-Value=@_LeftSelectedKern
                                   TValue="KernPair"
                                   AllowClear=true
                                   AllowVirtualization=true
                                   Data="@MainViewModel.LastSelectedGlyph?.LeftKernings"
                                   Style="min-height: 100px; max-height: 300px; width: 100%;"
                                   @ref=@_LeftKerningList>
                        <HeaderTemplate>
                            <RadzenCard Variant="Variant.Filled" Style="padding:10px; margin:5px;">
                                <RadzenStack Orientation="Orientation.Horizontal"
                                             AlignItems="AlignItems.Center"
                                             JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenButton Text="Add"
                                                  Icon="add_circle"
                                                  ButtonStyle="ButtonStyle.Primary"
                                                  Size="ButtonSize.ExtraSmall"
                                                  Shade="Shade.Lighter" 
                                                  Click="@OnLeftKerningAddClick"/>
                                    <RadzenButton Text="Remove"
                                                  Icon="do_not_disturb_on"
                                                  ButtonStyle="ButtonStyle.Secondary"
                                                  Size="ButtonSize.ExtraSmall"
                                                  Shade="Shade.Lighter" 
                                                  Click="@OnLeftKerningRemoveClick" />
                                </RadzenStack>
                            </RadzenCard>
                        </HeaderTemplate>
                        <Template>
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center"
                                         Gap="5px"
                                         Style="padding: 1px;">

                                <RadzenStack Orientation="Orientation.Vertical"
                                             AlignItems="AlignItems.Center"
                                             JustifyContent="JustifyContent.Center"
                                             Style="width:60px; height:60px; overflow: hidden;">
                                    @if (context is KernPair data && data != null && MainViewModel.GlyphsList.ContainsKey(data.Left))
                                    {
                                        <GlyphSVGComponent SVG="MainViewModel.GlyphsList[data.Left].SVG" Height="55" MaxWidth="55" />
                                        <div>
                                            <span style="font-size: 8px;">@(MainViewModel.GlyphsList[data.Left].Index)</span>
                                        </div>
                                    }
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Vertical"
                                             AlignItems="AlignItems.Center"
                                             JustifyContent="JustifyContent.Center"
                                             Style="width:60px; height:60px; overflow: hidden;">
                                    @if (context is KernPair data && data != null && MainViewModel.GlyphsList.ContainsKey(data.Right))
                                    {
                                        <GlyphSVGComponent SVG="MainViewModel.GlyphsList[data.Right].SVG" Height="55" MaxWidth="55" />
                                        <div>
                                            <span style="font-size: 8px;">@(MainViewModel.GlyphsList[data.Right].Index)</span>
                                        </div>
                                    }

                                </RadzenStack>
                                <RadzenFormField AllowFloatingLabel="@floatFieldLabel"
                                                 Variant="@variant"
                                                 Text="Value">
                                    <ChildContent>
                                        @if (context is KernPair data && data != null)
                                        {
                                            <RadzenNumeric @bind-Value="@(data.Value)"
                                                           Min="@int.MinValue"
                                                           Max="@int.MaxValue" />
                                        }
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenStack>
                        </Template>
                    </RadzenListBox>
                </RadzenStack>

                @* Glyph On The Right *@
                <RadzenStack Orientation="Orientation.Vertical" Gap="5px">
                    <RadzenText Text="Glyph On The Right:" TextStyle="TextStyle.Subtitle2" />
                    <RadzenListBox @bind-Value=@_RightSelectedKern
                                   TValue="KernPair"
                                   AllowClear=true
                                   AllowVirtualization=true
                                   Data="@MainViewModel.LastSelectedGlyph?.RightKernings"
                                   Style="min-height: 100px; max-height: 300px; width: 100%;"
                                   @ref=@_RightKerningList>
                        <HeaderTemplate>
                            <RadzenCard Variant="Variant.Filled" Style="padding:10px; margin:5px;">
                                <RadzenStack Orientation="Orientation.Horizontal"
                                             AlignItems="AlignItems.Center"
                                             JustifyContent="JustifyContent.SpaceBetween">
                                    <RadzenButton Text="Add"
                                                  Icon="add_circle"
                                                  ButtonStyle="ButtonStyle.Primary"
                                                  Size="ButtonSize.ExtraSmall"
                                                  Shade="Shade.Lighter" 
                                                  Click="@OnRightKerningAddClick" />
                                    <RadzenButton Text="Remove"
                                                  Icon="do_not_disturb_on"
                                                  ButtonStyle="ButtonStyle.Secondary"
                                                  Size="ButtonSize.ExtraSmall"
                                                  Shade="Shade.Lighter"
                                                  Click="@OnRightKerningRemoveClick"/>
                                </RadzenStack>
                            </RadzenCard>
                        </HeaderTemplate>
                        <Template>
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center"
                                         Gap="5px"
                                         Style="padding: 1px;">

                                <RadzenStack Orientation="Orientation.Vertical"
                                             AlignItems="AlignItems.Center"
                                             JustifyContent="JustifyContent.Center"
                                             Style="width:60px; height:60px; overflow: hidden;">
                                    @if (context is KernPair data && data != null && MainViewModel.GlyphsList.ContainsKey(data.Left))
                                    {
                                        <GlyphSVGComponent SVG="MainViewModel.GlyphsList[data.Left].SVG" Height="55" MaxWidth="55" />
                                        <div>
                                            <span style="font-size: 8px;">@(MainViewModel.GlyphsList[data.Left].Index)</span>
                                        </div>
                                    }
                                </RadzenStack>

                                <RadzenStack Orientation="Orientation.Vertical"
                                             AlignItems="AlignItems.Center"
                                             JustifyContent="JustifyContent.Center"
                                             Style="width:60px; height:60px; overflow: hidden;">
                                    @if (context is KernPair data && data != null && MainViewModel.GlyphsList.ContainsKey(data.Right))
                                    {
                                        <GlyphSVGComponent SVG="MainViewModel.GlyphsList[data.Right].SVG" Height="55" MaxWidth="55" />
                                        <div>
                                            <span style="font-size: 8px;">@(MainViewModel.GlyphsList[data.Right].Index)</span>
                                        </div>
                                    }

                                </RadzenStack>
                                <RadzenFormField AllowFloatingLabel="@floatFieldLabel"
                                                 Variant="@variant"
                                                 Text="Value">
                                    <ChildContent>
                                        @if (context is KernPair data && data != null)
                                        {
                                            <RadzenNumeric @bind-Value="@(data.Value)"
                                                           Min="@int.MinValue"
                                                           Max="@int.MaxValue" />
                                        }
                                    </ChildContent>
                                </RadzenFormField>
                            </RadzenStack>
                        </Template>
                    </RadzenListBox>
                </RadzenStack>

            </RadzenStack>
        </RadzenAccordionItem>
    </Items>
</RadzenAccordion>

<style>
    .rz-multiselect-item {
        padding: 5px !important;
         margin-left: 2px;
        margin-right: 2px;
    }
</style>