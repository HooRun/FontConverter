
<div class="glyph-container @(_IsSelected ? "is-selected" : "") @(_IsHovered ? "is-hovered" : "")"
     @onclick="OnClick"
     @ondblclick="ToggleSelection"
     @onmouseenter="OnMuseEnter"
     @onmouseleave="OnMouseLeave"
     style="width:@($"{_Dimentions.Width}px") !important; height:@($"{_Dimentions.Height}px") !important; display: @(GlyphId<0?"none":"block") !important; border-width: @($"{_Dimentions.BorderWidth}px") !important;"
     @ref="@_GlyphRef">

    <div class="glyph-header" style="height:@($"{_Dimentions.HeaderHeight}px") !important;">
        @_HeaderTitle
    </div>

    <SKCanvasView OnPaintSurface="OnPaintSurface"
                  IgnorePixelScaling="true"
                  style="@($"width:{_Dimentions.CanvasWidth}px; height:{_Dimentions.CanvasHeight}px;")"
                  class="glyph-canvas"
                  @ref="_SKCanvasView" />

    @if (_LastSelected)
    {
        <div class="last-selected"></div>
    }

</div>
